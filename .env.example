# =====================================================================
#  COPIA questo file in un nuovo file chiamato ".env" e metti i tuoi dati.
#  Il file ".env" NON viene mai caricato su GitHub (e' nel .gitignore).
# =====================================================================

# Le credenziali con cui entri nell'Extranet di Booking (admin.booking.com)
BOOKING_USERNAME=la-tua-email@esempio.com
BOOKING_PASSWORD=la-tua-password

# Vuoi vedere il browser mentre lavora? (utile la prima volta per capire cosa succede)
#   true  = browser NASCOSTO (piu' veloce, per l'uso di ogni giorno)
#   false = browser VISIBILE (per controllare/debug)
BOOKING_HEADLESS=false
